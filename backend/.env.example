APP_NAME=PixelBooth
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development lokal memakai SQLite (database/database.sqlite).
# Untuk production, set DB_CONNECTION=pgsql dan isi kredensial PostgreSQL.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pixelbooth
# DB_USERNAME=postgres
# DB_PASSWORD=your_postgres_password

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pixelbooth.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# Hardware Bridge
# ==========================================
HARDWARE_BRIDGE_URL=http://localhost:5000
HARDWARE_BRIDGE_SECRET=your_bridge_secret_key

# Frontend (untuk link QR code customer)
FRONTEND_URL=http://localhost:5173

# ==========================================
# Google Drive OAuth
# Dapatkan dari: https://console.cloud.google.com
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/google/callback"
GOOGLE_DRIVE_FOLDER_ID=

# ==========================================
# Laravel Sanctum
# ==========================================
# Auth memakai Bearer token (bukan session cookie),
# jadi stateful domain dikosongkan agar tidak wajib CSRF token.
SANCTUM_STATEFUL_DOMAINS=

# ==========================================
# File Upload Limits
# ==========================================
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

VITE_APP_NAME="${APP_NAME}"
